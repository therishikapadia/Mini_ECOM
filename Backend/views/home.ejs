<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Orders</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .header {
            text-align: center;
        }
    </style>
</head>
<body>
    <h1 class="header">All Orders</h1>

    <% if (order && order.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer Name</th>
                    <th>Customer Email</th>
                    <th>Order ID</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>
                <% order.forEach((ord, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= ord.customer.name %></td>
                        <td><%= ord.customer.email %></td>
                        <td><%= ord._id %></td>
                        <td><%= new Date(ord.createdAt).toLocaleString() %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No orders found.</p>
    <% } %>
</body>
</html>
