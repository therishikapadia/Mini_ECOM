<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard - Delivery Tracking</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyATwAQvAmj3kqExYa5-SVUAnkIEZlHxR-c"></script>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="sidebar">
                    <h2>Active Deliveries</h2>
                    <div id="active-deliveries-list" class="list-group">
                        <!-- Active deliveries will be populated here -->
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="main-content">
                    <h1>Delivery Monitoring Dashboard</h1>
                    <div class="dashboard-stats">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="stat-card">
                                    <h3>Active Deliveries</h3>
                                    <p id="active-count">0</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-card">
                                    <h3>Completed Today</h3>
                                    <p id="completed-count">0</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-card">
                                    <h3>Delayed</h3>
                                    <p id="delayed-count">0</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="map" style="height: 500px; width: 100%; margin: 20px 0;"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/admin-dashboard.js"></script>
</body>
</html>
